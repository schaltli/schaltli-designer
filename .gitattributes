# Shell scripts must keep LF line endings - a CRLF shebang line breaks
# execution on Linux (e.g. deploy/pekaway-install.sh, run on a Pekaway box).
*.sh text eol=lf

# The shared placeholder vectors are copied byte for byte into the firmware
# and the Android app, whose tests compare the copy with this file. LF on
# every checkout, as the copies are, or core.autocrlf breaks the comparison.
lib/placeholders/vectors.json text eol=lf

# The same for the screen graph's vectors (device contract 2.10).
lib/screen-graph/vectors.json text eol=lf

# And the chart's (tasks/charts-firmware-plan.md decision 4).
lib/chart/vectors.json text eol=lf
