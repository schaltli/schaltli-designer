{
  // What `npm run typecheck` uses. Identical to tsconfig.json except that it
  // does not look at `.next/types`.
  //
  // Those files are generated by Next for its route handlers, and a running
  // `next dev` rewrites and removes them continuously - so a typecheck that
  // reads them fails with TS6053 ("file not found") whenever it happens to
  // enumerate a file the dev server deletes a moment later. Observed exactly
  // that way on 2026-08-22: red, then green on an immediate re-run, with
  // nothing changed. A check that flickers gets ignored, which is worse than
  // not having one.
  //
  // Nothing is lost by skipping them: `next build` regenerates those types
  // and checks them itself, with the build stopped rather than running while
  // it does. This config covers the source, that one covers the routes.
  "extends": "./tsconfig.json",
  "include": ["next-env.d.ts", "types/**/*.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}
