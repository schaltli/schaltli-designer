      "template": "{{ value_json.temperature }}",
      "payload": "{\"temperature\": 21.5}",
      "result": "21.5"
    },
    {
      "template": "{{ value_json[\"a b\"] }}",
      "payload": "{\"a b\": \"x\"}",
      "result": "x"
    },
    {
      "template": "{{ value_json.list[1] }}",
      "payload": "{\"list\": [1, 2.0]}",
      "result": "2.0"
