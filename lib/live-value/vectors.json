{
  "about": "Shared test cases for live values (docs/2026-10-07-live-values.md). The designer (lib/live-value.ts), and later the firmware and the Android app, must agree on every case. `evaluate`: a live value's rules and a `value` that arrived (absent: nothing arrived; \"\" is an empty message that did); `applies` is the index of the rule that applies, or \"otherwise\", or \"noValueYet\". Rules are read top to bottom, the first that matches wins.",
  "evaluate": [
    { "name": "< on a number", "rules": [{ "op": "<", "operand": "3" }], "value": "2.5", "applies": 0 },
    { "name": "< on an equal number does not match", "rules": [{ "op": "<", "operand": "3" }], "value": "3", "applies": "otherwise" },
    { "name": "<= on an equal number", "rules": [{ "op": "<=", "operand": "3" }], "value": "3.0", "applies": 0 },
    { "name": "> on a negative number", "rules": [{ "op": ">", "operand": "-5" }], "value": "-4.5", "applies": 0 },
    { "name": ">= below does not match", "rules": [{ "op": ">=", "operand": "10" }], "value": "9.99", "applies": "otherwise" },
    { "name": "a number with spaces around it is a number", "rules": [{ "op": "<", "operand": "0" }], "value": "  -1 ", "applies": 0 },
    { "name": "a non-number matches no order operator: <", "rules": [{ "op": "<", "operand": "3" }], "value": "fan_only", "applies": "otherwise" },
    { "name": "a non-number matches no order operator: >=", "rules": [{ "op": ">=", "operand": "0" }], "value": "on", "applies": "otherwise" },
    { "name": "an empty message matches no order operator", "rules": [{ "op": "<", "operand": "1" }], "value": "", "applies": "otherwise" },
    { "name": "a non-number operand matches nothing", "rules": [{ "op": ">", "operand": "warm" }], "value": "20", "applies": "otherwise" },
    { "name": "== compares trimmed text", "rules": [{ "op": "==", "operand": "auto" }], "value": " auto ", "applies": 0 },
    { "name": "== is case-sensitive", "rules": [{ "op": "==", "operand": "auto" }], "value": "Auto", "applies": "otherwise" },
    { "name": "== compares text, not numbers", "rules": [{ "op": "==", "operand": "1" }], "value": "1.0", "applies": "otherwise" },
    { "name": "!= on different text", "rules": [{ "op": "!=", "operand": "off" }], "value": "heat", "applies": 0 },
    { "name": "!= on the same text", "rules": [{ "op": "!=", "operand": "off" }], "value": "off", "applies": "otherwise" },
    { "name": "is yes: true", "rules": [{ "op": "yes" }], "value": "true", "applies": 0 },
    { "name": "is yes: TRUE, any case", "rules": [{ "op": "yes" }], "value": "TRUE", "applies": 0 },
    { "name": "is yes: on", "rules": [{ "op": "yes" }], "value": "on", "applies": 0 },
    { "name": "is yes: Yes", "rules": [{ "op": "yes" }], "value": "Yes", "applies": 0 },
    { "name": "is yes: 1", "rules": [{ "op": "yes" }], "value": "1", "applies": 0 },
    { "name": "is yes: a number other than 0", "rules": [{ "op": "yes" }], "value": "1200", "applies": 0 },
    { "name": "is yes: a negative number", "rules": [{ "op": "yes" }], "value": "-0.5", "applies": 0 },
    { "name": "is yes: trimmed", "rules": [{ "op": "yes" }], "value": " on\n", "applies": 0 },
    { "name": "is yes: fan_only is neither", "rules": [{ "op": "yes" }], "value": "fan_only", "applies": "otherwise" },
    { "name": "is no: false", "rules": [{ "op": "no" }], "value": "false", "applies": 0 },
    { "name": "is no: Off", "rules": [{ "op": "no" }], "value": "Off", "applies": 0 },
    { "name": "is no: no", "rules": [{ "op": "no" }], "value": "NO", "applies": 0 },
    { "name": "is no: 0", "rules": [{ "op": "no" }], "value": "0", "applies": 0 },
    { "name": "is no: 0.0 is a number equal to 0", "rules": [{ "op": "no" }], "value": "0.0", "applies": 0 },
    { "name": "is no: an empty message", "rules": [{ "op": "no" }], "value": "", "applies": 0 },
    { "name": "is no: fan_only is neither", "rules": [{ "op": "no" }], "value": "fan_only", "applies": "otherwise" },
    { "name": "is yes does not match no", "rules": [{ "op": "yes" }], "value": "off", "applies": "otherwise" },
    { "name": "nothing arrived: no value yet, never no", "rules": [{ "op": "no" }], "applies": "noValueYet" },
    { "name": "nothing arrived: no value yet before any rule", "rules": [{ "op": "!=", "operand": "x" }], "applies": "noValueYet" },
    { "name": "the first rule that matches wins", "rules": [{ "op": "<", "operand": "0" }, { "op": "<", "operand": "3" }, { "op": "<", "operand": "10" }], "value": "1", "applies": 1 },
    { "name": "an earlier rule wins over a later one that also matches", "rules": [{ "op": "<", "operand": "3" }, { "op": "<", "operand": "0" }], "value": "-2", "applies": 0 },
    { "name": "no rules: otherwise", "rules": [], "value": "42", "applies": "otherwise" },
    { "name": "no rules and nothing arrived: no value yet", "rules": [], "applies": "noValueYet" }
  ]
}
