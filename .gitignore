# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e
/test-results/

# deploy zips staged for devices to download (app/api/deploy) - runtime
# state, not source
/.data/
/playwright-report/
/playwright/.cache/

# HIL test output (generated per-run, see hil/README.md)
/hil/epaper/report/
/hil/android/report/
/hil/waveshare/report/
/hil/waveshare4v3b/report/
/hil/conformance/report/
/hil/epaper/designer-preview/
# What the factory-flash run leaves behind: its verdict and the merged image it
# wrote (about 2 MB, rebuilt from the firmware checkout every run)
/hil/factory-flash/results.json
/hil/factory-flash/*.bin

# Local agent/editor configuration and one-off scratch artifacts
/.claude/
/.scratch-*
/scripts/preview-sheet.png

# Firmware images fetched by scripts/fetch-firmware.js - named by the
# committed firmware/manifest.json, downloaded from the GitHub release
/firmware/bin/

# The assembled flasher page: built by scripts/build-flasher.js from the
# releases, published as a Pages stand, never committed (it carries images)
/.flasher-dist/

# esptool-js and esbuild for that build, installed beside it rather than as
# project dependencies:
#   npm install --prefix .flasher-deps --no-save esptool-js@0.6.1 esbuild@0.24.0
/.flasher-deps/
